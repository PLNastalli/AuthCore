{
  "openapi": "3.0.3",
  "info": {
    "title": "AuthCore",
    "version": "0.1.0",
    "description": "API-only Rust authentication service. External Google OIDC and Resend mail delivery need credentials and independent verification."
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Credentials": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 1024
          }
        }
      },
      "ChangePassword": {
        "type": "object",
        "required": [
          "current_password",
          "new_password"
        ],
        "properties": {
          "current_password": {
            "type": "string"
          },
          "new_password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 1024
          }
        }
      },
      "TokenResponse": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string"
          },
          "token_type": {
            "type": "string",
            "example": "Bearer"
          },
          "expires_in": {
            "type": "integer"
          }
        }
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "ForgotPassword": {
        "type": "object",
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "ResetPassword": {
        "type": "object",
        "required": [
          "token",
          "new_password"
        ],
        "properties": {
          "token": {
            "type": "string"
          },
          "new_password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 1024
          }
        }
      },
      "VerifyEmail": {
        "type": "object",
        "required": [
          "token"
        ],
        "properties": {
          "token": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          }
        }
      },
      "ResendVerification": {
        "type": "object",
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          }
        }
      }
    },
    "requestBodies": {
      "Credentials": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Credentials"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Liveness",
        "responses": {
          "200": {
            "description": "Alive"
          }
        }
      }
    },
    "/ready": {
      "get": {
        "summary": "PostgreSQL and Redis readiness",
        "responses": {
          "200": {
            "description": "Ready"
          },
          "503": {
            "description": "Unavailable"
          }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "summary": "Register a local account",
        "requestBody": {
          "$ref": "#/components/requestBodies/Credentials"
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Invalid input"
          },
          "409": {
            "description": "Duplicate account"
          },
          "429": {
            "description": "Rate limited"
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "summary": "Log in, issue access JWT and refresh cookie",
        "requestBody": {
          "$ref": "#/components/requestBodies/Credentials"
        },
        "responses": {
          "200": {
            "description": "Authenticated"
          },
          "401": {
            "description": "Invalid credentials"
          },
          "429": {
            "description": "Rate limited"
          }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "summary": "Rotate refresh token",
        "description": "Requires Cookie authcore_refresh and an Origin header matching PUBLIC_ORIGIN. Production uses __Host-authcore_refresh.",
        "responses": {
          "200": {
            "description": "Rotated"
          },
          "401": {
            "description": "Invalid token"
          },
          "403": {
            "description": "Invalid Origin"
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "summary": "Current user",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "User"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "summary": "Revoke current session",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Revoked"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/v1/auth/logout-all": {
      "post": {
        "summary": "Revoke all sessions",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Revoked"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/v1/auth/change-password": {
      "post": {
        "summary": "Update password and revoke all sessions",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePassword"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Updated"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/v1/auth/sessions": {
      "get": {
        "summary": "List active sessions",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Sessions"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/v1/auth/sessions/{id}": {
      "delete": {
        "summary": "Revoke session by ID",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Revoked"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/api/v1/auth/forgot-password": {
      "post": {
        "summary": "Request email with a one-time password-reset token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ForgotPassword"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted, regardless of account existence"
          },
          "429": {
            "description": "Rate limited"
          },
          "503": {
            "description": "Mail provider not configured"
          }
        }
      }
    },
    "/api/v1/auth/reset-password": {
      "post": {
        "summary": "Consume reset token and revoke all active sessions",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetPassword"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Password changed"
          },
          "401": {
            "description": "Invalid, expired, or already consumed token"
          }
        }
      }
    },
    "/api/v1/oauth/google/start": {
      "get": {
        "summary": "Start Google OIDC + PKCE",
        "responses": {
          "307": {
            "description": "Redirect to Google"
          },
          "503": {
            "description": "Provider not configured"
          }
        }
      }
    },
    "/api/v1/oauth/google/callback": {
      "get": {
        "summary": "Validate OIDC callback and issue AuthCore session",
        "parameters": [
          {
            "name": "state",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "code",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Access JWT plus secure refresh cookie"
          },
          "401": {
            "description": "Invalid provider response"
          },
          "403": {
            "description": "Invalid state binding"
          }
        }
      }
    },
    "/api/v1/auth/verify-email": {
      "post": {
        "summary": "Verify email using a single-use token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyEmail"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Confirmed"
          },
          "401": {
            "description": "Invalid token"
          },
          "429": {
            "description": "Rate limited"
          }
        }
      }
    },
    "/api/v1/auth/resend-verification": {
      "post": {
        "summary": "Request verification email without account enumeration",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResendVerification"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted"
          },
          "429": {
            "description": "Rate limited"
          },
          "503": {
            "description": "Mail provider unavailable"
          }
        }
      }
    }
  }
}
