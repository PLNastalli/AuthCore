# Local-only defaults. Never reuse these credentials in production.
DATABASE_URL=postgres://authcore:authcore_dev_only@localhost:5432/authcore
REDIS_URL=redis://127.0.0.1:6379/
BIND_ADDR=127.0.0.1:3000
PUBLIC_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
JWT_PRIVATE_KEY_PATH=.dev-keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=.dev-keys/jwt-public.pem
JWT_ISSUER=authcore-local
JWT_AUDIENCE=authcore-api
RUST_LOG=authcore=info,tower_http=info
