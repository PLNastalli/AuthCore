# Local-only defaults. Never reuse these credentials in production.
DATABASE_URL=postgres://authcore:authcore_dev_only@localhost:5432/authcore
REDIS_URL=redis://127.0.0.1:6379/
BIND_ADDR=127.0.0.1:3000
PUBLIC_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
# For cargo run in debug mode on loopback ONLY. Never accepted by release builds.
AUTHCORE_DEV_SKIP_EMAIL_VERIFICATION=true
JWT_PRIVATE_KEY_PATH=.dev-keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=.dev-keys/jwt-public.pem
JWT_ISSUER=authcore-local
JWT_AUDIENCE=authcore-api
RUST_LOG=authcore=info,tower_http=info

# Optional Google OpenID Connect (configure all three; use localhost callback in Google Cloud)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/oauth/google/callback

# Optional password-reset delivery through Resend (never use developer email credentials in source)
# RESEND_API_KEY=
# RESET_FROM_EMAIL=auth@example.com

# JWT signing-key rotation: active key identifier and optionally old trusted public keys.
JWT_ACTIVE_KID=primary
# JSON object of previous key IDs -> PEM file paths (keep until old tokens expire).
# JWT_LEGACY_PUBLIC_KEYS_JSON={"old-2026":"/app/keys/old-public.pem"}
